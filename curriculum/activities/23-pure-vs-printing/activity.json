{
  "metadata": {
    "activity_id": "23_pure_vs_printing",
    "title": "Return, Don't Print",
    "version": "1.0",
    "description": "Write a pure function that returns its result and produces no output of its own."
  },
  "instructions": {
    "main": "Define `double(n)` that returns twice `n`. Calling `double(4)` must return `8` and print nothing.",
    "steps": [
      "Define `def double(n):`.",
      "Return the result with `return n * 2` — do not `print` inside the function.",
      "A checker will call `double(4)` and capture any output the call produces; it must be empty."
    ]
  },
  "ui_settings": {
    "show_hint_panel": true,
    "suspend_data_limit": 4096
  },
