{
  "metadata": {
    "activity_id": "10_sum_1_to_n",
    "title": "Sum 1 to n with a Loop",
    "version": "1.0",
    "description": "Accumulate the sum of 1..n into a variable using a for loop and an augmented assignment."
  },
  "instructions": {
    "main": "Set `n = 10`, then use a loop to sum the numbers 1 to n into a variable named `total`.",
    "steps": [
      "Initialize `total` to 0 before the loop.",
      "Loop `i` over `range(1, n + 1)`.",
      "Add each value with `total += i`."
    ]
  },
  "ui_settings": {
    "show_hint_panel": true,
    "suspend_data_limit": 4096
  },
  "python_setup": {
    "starter_code": "",
    "files": [],
    "packages": [],
    "pyodide_base_url": ""
  },
  "hints": [
    {
      "id": "hint-start",
      "trigger": {
        "event": "code_change",
        "conditions": { "type": "source_empty" }
      },
      "message": "Start with `total = 0` and a `for i in range(1, n + 1):` loop.",
      "display_mode": "checklist",
      "priority": 1,
      "delay_seconds": 0,
      "show_once": false,
      "style": "success"
    },
    {
      "id": "hint-reset",
      "trigger": {
        "event": "code_change",
        "conditions": { "type": "ast_pattern", "pattern": "total = 1" }
      },
      "message": "An accumulator must start at 0 — `total = 1` skips resetting and skews the sum.",
