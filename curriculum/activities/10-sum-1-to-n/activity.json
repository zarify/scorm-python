      "message": "Build the sum yourself: initialize `total = 0` and add each value with `total += i` inside a loop.",
      "display_mode": "triggered",
      "priority": 2,
      "delay_seconds": 0,
      "show_once": true,
      "style": "warning"
    },
    {
      "id": "hint-after-fail",
      "trigger": {
        "event": "test_fail",
        "after_attempts": 1
      },
      "message": "Check that `total` starts at 0 and that every value from 1 to n is added inside the loop.",
      "display_mode": "triggered",
      "priority": 2,
      "delay_seconds": 0,
      "show_once": false,
      "style": "warning"
    }
