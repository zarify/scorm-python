{
  "metadata": {
    "activity_id": "14_list_comprehension",
    "title": "Squares with a List Comprehension",
    "version": "1.0",
    "description": "Build the list of squares of 0..n-1 in one expression using a list comprehension."
  },
  "instructions": {
    "main": "Set `n = 5` and build `squares` — the squares of 0, 1, 2, 3, 4 — using a list comprehension (no loop, no append).",
    "steps": [
      "Write `squares = [i * i for i in range(n)]`.",
      "The comprehension alone must produce the whole list."
    ]
  },
